{
  "name": "ngx-font-picker",
  "description": "Google fonts font picker widget for Angular",
  "bugs": "https://github.com/zefoy/ngx-font-picker/issues",
  "version": "20.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "ng": "ng",
    "lint": "ng lint",
    "start": "ng serve app",
    "build": "ng build lib",
    "deploy": "deploy-to-git",
    "prepare": "ng build lib --configuration production",
    "publish": "npm publish ./dist/lib",
    "predeploy": "rimraf ./dist/app && mkdirp ./dist/app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zefoy/ngx-font-picker.git"
  },
  "config": {
    "deployToGit": {
      "repository": "git@github.com:zefoy/ngx-font-picker.git",
      "branch": "gh-pages",
      "folder": "dist/app",
      "script": "ng build app --configuration production --base-href=ngx-font-picker --delete-output-path=false",
      "commit": "Publishing $npm_package_version",
      "user": {
        "name": "ZEF Devel",
        "email": "devel@zef.fi"
      }
    }
  },
  "dependencies": {
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.30",
    "@angular/compiler": "^20.3.30",
    "@angular/core": "^20.3.30",
    "@angular/forms": "^20.3.30",
    "@angular/platform-browser": "^20.3.30",
    "@angular/platform-browser-dynamic": "^20.3.30",
    "core-js": "^3.50.0",
    "ngx-scrollbar": "^18.0.0",
    "rxjs": "^7.8.2",
    "tailwindcss": "~3.4.19",
    "webfontloader": "^1.6.28",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.35",
    "@angular-eslint/builder": "^20.7.0",
    "@angular-eslint/eslint-plugin": "^20.7.0",
    "@angular-eslint/eslint-plugin-template": "^20.7.0",
    "@angular-eslint/schematics": "^20.7.0",
    "@angular-eslint/template-parser": "^20.7.0",
    "@angular/cli": "^20.3.35",
    "@angular/compiler-cli": "^20.3.30",
    "@types/webfontloader": "^1.6.38",
    "@typescript-eslint/eslint-plugin": "8.68.0",
    "@typescript-eslint/parser": "8.68.0",
    "cpx": "^1.5.0",
    "deploy-to-git": "^0.4.1",
    "eslint": "^8.57.1",
    "mkdirp": "^3.0.1",
    "ng-packagr": "^20.3.2",
    "rimraf": "^6.1.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "^6.0.4",
    "terser": "^5.51.2",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "watch": "^1.0.2"
  }
}
